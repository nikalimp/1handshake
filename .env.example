# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app runs (used for metadata and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI visit card from the guest's intro (optional: without it the card is the intro as is)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Matches in connect (I need / I can). Without the key, matching falls back to keywords.
# ANTHROPIC_MATCH_MODEL=claude-haiku-5-5

# Browser notifications (web push). Generate a pair: npx web-push generate-vapid-keys
# The public key is also in src/lib/push-public.ts; set both if you generate your own.
VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Next steps
SPEECH_TO_TEXT_API_KEY=
