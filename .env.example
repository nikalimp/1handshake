# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app runs (OAuth redirects, invites, metadata). NEXT_PUBLIC_SITE_URL is the older name for the same thing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where public cards are linked and indexed. Set to https://1handshake.com once the site proxies /@handle
# to the app; until then cards use the app's address.
# NEXT_PUBLIC_CARD_URL=https://1handshake.com
# In production on Vercel, JS/CSS/fonts load from https://app.1handshake.com (see next.config.ts); override with ASSET_PREFIX.

# Google Gemini (free tier in Google AI Studio): voice → text, intro → card, matches.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# AI visit card from the guest's intro (optional: without it the card is the intro as is).
# When set, Claude is used instead of Gemini for the card and matches.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Matches in connect (I need / I can). Without the key, matching falls back to keywords.
# ANTHROPIC_MATCH_MODEL=claude-haiku-5-5

# Browser notifications (web push). Generate a pair: npx web-push generate-vapid-keys
# The public key is also in src/lib/push-public.ts; set both if you generate your own.
VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Next steps
SPEECH_TO_TEXT_API_KEY=
